# ═════════════════════════════════════════════════════
#   Environment Configuration — HYDRAA
#   Copy this to .env and fill in your values
# ═════════════════════════════════════════════════════

# Server
NODE_ENV=production
PORT=5000
APP_URL=http://localhost:5000

# Database (MySQL)
DB_HOST=mysql.railway.internal
DB_USER=root
DB_PASSWORD=railway
DB_NAME=railway

# JWT
JWT_SECRET=hydraa-secret-key-2026
JWT_EXPIRES_IN=7d

# Email (Gmail)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=your-gmail@gmail.com
EMAIL_PASS=your-app-password-here

# Frontend URL (for email links)
FRONTEND_URL=http://localhost:3000

# Default Admin (used by create-admin.js)
ADMIN_USERNAME=hydraa_admin
ADMIN_EMAIL=admin@hydraa.telangana
ADMIN_PASSWORD=ChangeMe@1234
ADMIN_FULL_NAME=HYDRAA Administrator

# Push Notifications (VAPID)
VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
VAPID_EMAIL=mailto:admin@hydraa.telangana

# Logging
LOG_LEVEL=info
